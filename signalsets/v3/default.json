{ "hdr": "DA40", "rax": "40", "cmd": {"22": "416E"}, "freq": 5, "dbgfilter": { "to": 2024, "from": 2026 },
  "signals": [
    {"id": "LYRIQ_HVBAT_GRP3_V", "path": "Battery", "fmt": { "len": 16, "max": 65, "div": 100, "unit": "volts" }, "name": "Traction battery group 3 voltage", "description": "~51 V battery groups; they moved with charge and load (51.14 V charging, 50.98 V idle) and read 0 with the vehicle off. During an unattended overnight AC charge the group 1 voltage read 0, then held 51.08 V for 3 h of ~21 A charging, so they are not live in every wake mode."}
  ]},
{ "hdr": "DA40", "rax": "40", "cmd": {"22": "434F"}, "freq": 5, "dbgfilter": { "to": 2024, "from": 2026 },
  "signals": [
    {"id": "LYRIQ_HVBAT_T", "path": "Battery", "fmt": { "len": 8, "max": 215, "min": -40, "add": -40, "nullmin": -40, "unit": "celsius" }, "name": "Traction battery temperature", "description": "Same encoding as Chevy Bolt 7E4 22434F. Raw 0x00 (-40 C) means no reading: during an unattended AC charge it was 0x00 in 644 of 710 replies, with the rest between 3 and 30 C."}
