{ "hdr": "DA40", "rax": "40", "cmd": {"22": "4124"}, "freq": 5, "dbgfilter": { "to": 2024, "from": 2026 },
  "signals": [
    {"id": "LYRIQ_HVBAT_T_B", "path": "Battery", "fmt": { "len": 16, "max": 2047, "div": 32, "unit": "celsius" }, "name": "Traction battery temperature sensor B", "hidden": true, "description": "Holds one value per session on a 2025 LYRIQ rather than tracking temperature: 0x01A2 (13.06 C) on every sample of a drive and of a 9 h charge to 100 % three days later, while 40E5 and 40E6 rose by several degrees; an earlier session read 0x03DC (30.9 C). Possibly a value latched at wake. Hidden so it is not read as a live pack temperature."}
  ]},
{ "hdr": "DA40", "rax": "40", "cmd": {"22": "4127"}, "freq": 5, "dbgfilter": { "to": 2024, "from": 2026 },
  "signals": [
    {"id": "LYRIQ_HVBAT_T_A", "path": "Battery", "fmt": { "len": 16, "max": 2047, "div": 32, "unit": "celsius" }, "name": "Traction battery temperature sensor A", "hidden": true, "description": "Not live on a 2025 LYRIQ: read exactly 0x0418 (32.75 C) on every sample from August to late September 2026, across four multi-hour charges and a Ready dwell, while 40E5 and 40E6 moved. The 2025 capture in this repo reads 0x00EA (7.31 C), so it is not a fixed constant either; meaning unknown. Hidden so it is not read as a live pack temperature."}
  ]},
{ "hdr": "DA40", "rax": "40", "cmd": {"22": "4149"}, "freq": 5, "dbgfilter": { "to": 2024, "from": 2026 },
  "signals": [
    {"id": "LYRIQ_EVSE_PILOT_C", "path": "Battery", "fmt": { "len": 16, "max": 100, "div": 10, "unit": "amps" }, "name": "Charge station pilot current", "description": "Matches the J1772 pilot-advertised AC current limit with the car awake: 38.8 A on a 9.2 kW EVSE while plugged, snapping to a 10.0 A default when unplugged. During an unattended overnight AC charge it read 16.0 A and later 9.6 A while charging at about 7.9 kW DC (roughly 9.4 kW AC, about 39 A at 240 V, more than either reading allows), so in that low-power wake mode it does not track the pilot."}
  ]},
